# Copy to .env.data-layer and fill in.
#
# SERVER-SIDE ONLY. Kept separate from .env on purpose: .env is the Expo app's
# bundle-time env, and everything in it should be treated as shipping inside the
# app. Nothing here ever reaches the client — these are read by the ingest jobs
# in data-layer/, which run on your machine or in CI.
#
# The npm data:* scripts load .env and this file, in that order, so the Supabase
# URL is inherited from .env and does not need repeating here.

# Required. Project Settings -> API -> service_role. Bypasses RLS, which is
# what lets the ingest write to `observations` — the publishable key cannot.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, free. Register at https://ember-energy.org/data/api/
# Upgrades renewable-share from OWID's annual resolution to Ember's monthly.
# Without it that metric falls back to the annual series and nothing else
# changes.
EMBER_API_KEY= 
